# Base de données PostgreSQL (Neon - https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT
JWT_SECRET="change-this-secret-min-32-characters"
JWT_REFRESH_SECRET="change-this-refresh-secret-min-32"

# App
NEXTAUTH_URL="https://votre-domaine.vercel.app"
NEXT_PUBLIC_APP_URL="https://votre-domaine.vercel.app"

# OpenAI (optionnel - pour l'IA réelle)
OPENAI_API_KEY="sk-..."

# Wave (optionnel - pour le vrai paiement)
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
